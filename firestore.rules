rules_version = '2';

// ScriptureTok live game. Paste into Firebase console → Firestore → Rules.
//
// A game lives at /live/{code}. The TV that made it is the host: only it
// changes the game, keeps score, reads answers, and ends it. Anyone signed
// in (anonymous sign-in is enough) can join with the code. A player can
// only add themselves, rename themselves, and send one answer per question,
// only while that question is open, stamped with the server's clock, so
// speed points can't be faked.
service cloud.firestore {
  match /databases/{database}/documents {

    match /live/{code} {
      function game() { return get(/databases/$(database)/documents/live/$(code)).data; }
      function signedIn() { return request.auth != null; }
      function isHost() { return signedIn() && game().host == request.auth.uid; }

      allow read: if signedIn();
      allow create: if signedIn()
        && code.matches('^[0-9]{4}$')
        && request.resource.data.host == request.auth.uid
        && request.resource.data.state == 'lobby';
      allow update, delete: if signedIn() && resource.data.host == request.auth.uid;

      match /players/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'score', 'last'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 16
          && request.resource.data.score == 0;
        // The host keeps score; a player may only change their own name.
        allow update: if isHost()
          || (signedIn() && request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
              && request.resource.data.name is string && request.resource.data.name.size() <= 16);
        allow delete: if isHost();
      }

      match /answers/{id} {
        // Only the host sees answers, so nobody can peek at what others picked.
        allow read, delete: if isHost();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'qi', 'choice', 'at'])
          && request.resource.data.uid == request.auth.uid
          && id == string(request.resource.data.qi) + '_' + request.auth.uid
          && game().state == 'question'
          && game().qi == request.resource.data.qi
          && request.resource.data.choice is string
          && request.resource.data.at == request.time;
      }
    }

    // Nothing else is readable or writable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
